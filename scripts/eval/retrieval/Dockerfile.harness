# The retrieval bench's client (#1242): Python with the PostgreSQL driver, an HTTP client, a tokenizer for token counts and the
# Anthropic SDK for answer accuracy on Claude. Python 3.15 has no wheel of psycopg-binary 3.2.12 or tiktoken 0.12.0 (a slim image has no
# compiler), so these two pins are the first releases with a cp315 wheel: psycopg 3.3.x (3.3.9 was the newest on 2026-11-13) and tiktoken 0.14.0.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
RUN pip install --no-cache-dir "psycopg[binary]==3.3.9" "httpx==0.28.1" "tiktoken==0.14.0" "anthropic==2.7.0" \
 && python -c "import tiktoken; tiktoken.get_encoding('o200k_base')"
WORKDIR /bench
