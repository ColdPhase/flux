# Application variable reference only; never loaded by Compose or the launcher.
# docker/.env.example is the sole executable template, copied once to docker/.env by ./flux.
# Compose project; ./flux fills in a name unique to this checkout on first use.
FLUX_PROJECT=
FLUX_PORT=8081
POSTGRES_USER=flux
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=flux
FLUX_FIXTURE_TOKEN=replace-with-a-long-random-token
# Identity (issue #29). The only origin browsers may use; must match how people open Flux.
FLUX_PUBLIC_ORIGIN=http://127.0.0.1:8081
# At least 32 random characters. Changing it signs out every session.
FLUX_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional O-007 background compute key custody: absolute host path to 32 raw random bytes.
# Store outside the repository and database backup; empty keeps this capability unavailable.
FLUX_BACKGROUND_KEY_HOST_FILE=
# Owner AI connections (F-020, #179): private targets an OpenAI-compatible endpoint may reach, e.g.
# "ollama,10.0.0.0/8". Host names, IP addresses or CIDR ranges, comma-separated. Empty allows only
# public HTTPS endpoints; cloud metadata addresses are always refused. Read by the API and worker.
FLUX_AI_PRIVATE_TARGETS=
# `on` lets people's agents run on their own API key (F-020, F-036; a Claude or ChatGPT plan needs the agent runtime
# instead). Needs FLUX_BACKGROUND_KEY_HOST_FILE. Empty or `off` keeps API-key runs unavailable. Read by the API and worker.
FLUX_PERSONAL_RUNS=
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is believed. Empty trusts none.
FLUX_TRUSTED_PROXIES=
# SMTP for password reset mail. Empty means password reset reports "unavailable".
# With the dev profile, smtp://mailpit:1025 delivers to the local mail catcher.
FLUX_SMTP_URL=
FLUX_MAIL_FROM=
FLUX_PASSWORD_RESET_TTL_SECONDS=3600
# How long a session lasts unused and the longest it lasts from sign-in, such as 30m, 12h or 7d. Empty is 7d and 30d.
FLUX_SESSION_IDLE=
FLUX_SESSION_MAX_AGE=
# Who may create a password account: open (anyone who can reach Flux), verified (a new account confirms
# its address by mail first; needs FLUX_SMTP_URL) or off. A sign-on provider in sso mode closes password sign-up.
FLUX_SIGNUP=open
# Optional single sign-on with one OpenID Connect provider (docs/operations/single-sign-on.md).
# Set issuer and client id together; the client secret is a file on the host.
FLUX_OIDC_ISSUER=
FLUX_OIDC_CLIENT_ID=
FLUX_OIDC_CLIENT_SECRET_HOST_FILE=
FLUX_OIDC_LABEL=
# Link existing accounts while prepare; switch to sso after linking.
FLUX_SSO_MODE=sso
# Maximum age of provider confirmation: whole hours or days, from 1h to 30d.
FLUX_OIDC_CONFIRMATION_MAX_AGE=7d
# refresh (default) checks every 15 minutes that the provider still honours each person; off disables it.
FLUX_OIDC_STANDING=refresh
FLUX_OIDC_STANDING_INTERVAL_SECONDS=900
FLUX_AUTH_RATE_LIMIT=true
FLUX_STREAM_HEARTBEAT_MS=25000
# Map/wiki collaboration: missing/empty/on enables it; off is the operator opt-out.
# Save shared working copies before planned disable; re-enable to recover/save any unsaved copy.
FLUX_LIVE_EDITING=on
# Link cards (#469): `on` lets the server fetch the title and description of a web address in a
# message, so its card shows the page's own words. Off by default: a fetch tells the site this
# server's address, and a pasted link can itself be private. Public http(s) addresses on the default
# ports only; private, loopback and link-local addresses are never fetched; encrypted workspaces
# never fetch at all.
FLUX_LINK_PREVIEWS=off
# The largest video one person can send, in MiB (1 to 1024; #1352, C-61). Every other file stays at 5 MiB. Videos count against the files volume.
FLUX_VIDEO_MAX_MIB=200
# Agents reading and searching the web (#918, #954, C-29): on by default. An agent reads a public page
# (the flux_read_web tool: GET only, public http(s) addresses on the default ports, bounded) and searches with its
# provider's own web search (Anthropic, OpenAI; $0.01 a search in the key's daily budget). `off` turns both off: a read
# tells the site this server's address, a search sends the query to the provider's search partner, and the open web can
# try to instruct an agent (rights, waits and Undo are the defence). An agent reads only an address it was given (in the
# request, the task or its conversation), found on a page it read or returned by its own search in the same run, as many as
# a question needs; the run lists its searches and every address asked for, under its answer or in its end line.
FLUX_WEB_READS=on
# The optional local embedding container (F-042, #1294): `on` makes ./flux layer docker/compose.embeddings.yaml (bge-m3 in
# text-embeddings-inference, about 3.2 GiB of RAM idle) so search also ranks by meaning. Off: no container, nothing stored.
FLUX_EMBEDDINGS=off
FLUX_MAILPIT_PORT=8025
# ./flux dev only: the Vite dev server port; the dev origin is http://127.0.0.1:<port>.
FLUX_DEV_PORT=5173
# Web Push (issue #41). Generate once per deployment, see docs/development/containers.md.
# Both keys empty means push reports "unavailable" and notifications stay in the in-app inbox.
FLUX_VAPID_PUBLIC_KEY=
FLUX_VAPID_PRIVATE_KEY=
# Optional contact for push services: mailto:ops@example.org or an https:// URL. Empty, it is FLUX_PUBLIC_ORIGIN when that is https.
FLUX_VAPID_SUBJECT=
# Development demo only (./flux demo): passwords of the two demo accounts it creates.
# ./flux fills them in; leave them empty on a real deployment and never run the demo there.
FLUX_DEMO_OWNER_PASSWORD=
FLUX_DEMO_PARTNER_PASSWORD=

# Optional read-only GitHub App. Set all six together; never share secrets with agents/models.
FLUX_GITHUB_CLIENT_ID=
FLUX_GITHUB_CLIENT_SECRET=
FLUX_GITHUB_APP_ID=
FLUX_GITHUB_APP_SLUG=
FLUX_GITHUB_WEBHOOK_SECRET=
# webhook (GitHub reaches this server) or poll (no public address: open linked PRs every 2 minutes).
FLUX_GITHUB_DELIVERY=webhook
# 32-byte hex AES key; preserve with backups to reconnect retained credentials.
FLUX_GITHUB_ENCRYPTION_KEY=

# The agent in Flux on the owner's own Claude Code or Codex (F-022 AIM-3; docs/operations/agent-runtime.md).
# Empty (the default) is off: no runtime service runs. claude_code, codex or claude_code,codex starts the
# Compose profile `runtime` with ./flux up.
FLUX_AGENT_RUNTIME=
# Required with claude_code: the date (YYYY-MM-DD) you agreed to Anthropic's Commercial Terms with Anthropic.
# Flux records this statement; it does not verify it.
FLUX_AGENT_RUNTIME_COMMERCIAL_TERMS=
# Optional idle policy: release a binding after this many days without a run (1-365). Empty is off.
FLUX_AGENT_RUNTIME_IDLE_DAYS=
# Optional. How many agents run at once; empty works it out from the runtime's memory, about 2 on a 4 GB server.
FLUX_RUNTIME_MAX_RUNS=
# Optional. What the runtime may use together. Empty: ./flux takes the server's memory less 1.25 GiB and all its CPUs but one.
FLUX_RUNTIME_MEMORY=
FLUX_RUNTIME_CPUS=
# Secrets ./flux generates: the service secret (API, worker, runtime-manager) and the runtime's own
# (the runtime and runtime-manager only).
FLUX_RUNTIME_MANAGER_SECRET=
FLUX_RUNTIME_SECRET_1=
# Encrypted workspaces (F-030). ./flux generates FLUX_KEYRING_TOKEN (and ./flux upgrade adds it to an older file);
# it authenticates the API and worker to the keyring on its internal network and opens nothing by itself.
# FLUX_KEYRING=off disables encrypted workspaces (each stays locked). FLUX_SWAP_ACKNOWLEDGED=encrypted-swap declares
# that every swap device is encrypted with a key not stored on disk; only then may keys be held where swap is on.
FLUX_KEYRING=on
FLUX_KEYRING_TOKEN=
# ./flux generates FLUX_KEY_PIN_SECRET too (and ./flux upgrade adds it): the API and worker pin every unlock password
# and key version of an encrypted space with it, so rows planted in the database are refused. Never change it: every
# encrypted space made with it would then refuse to unlock. Back it up with this file, not with the database.
FLUX_KEY_PIN_SECRET=
FLUX_SWAP_ACKNOWLEDGED=
# Memory of db, api, worker and keyring; swap is limited to the same value, so these containers cannot swap.
# The defaults add up to under 3 GiB: the whole base stack fits a 4 GB host.
FLUX_DB_MEMORY=768m
FLUX_API_MEMORY=1536m
FLUX_WORKER_MEMORY=512m
FLUX_KEYRING_MEMORY=128m
