{
  "name": "flux",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build && tsc -p tooling/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 tests/app/*.test.ts"
  },
  "dependencies": {
    "@flux/contracts": "workspace:*",
    "@flux/core": "workspace:*",
    "@flux/db": "workspace:*",
    "@flux/runtime-protocol": "workspace:*",
    "pg-boss": "12.38.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fastify/websocket": "11.3.7",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "8.18.2",
    "drizzle-orm": "0.45.4",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fastify": "5.12.8",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "ws": "8.22.1",
    "yjs": "13.6.33"
  }
}
