{
  "name": "flux",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build && tsc -p infra/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test tests/app/*.test.ts"
  },
  "dependencies": {
    "@flux/contracts": "workspace:*",
    "@flux/core": "workspace:*",
    "@flux/db": "workspace:*",
    "pg-boss": "12.35.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "24.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "drizzle-orm": "0.45.3",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fastify": "5.6.1",
    "playwright": "1.63.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "ws": "8.22.0"
  }
}
