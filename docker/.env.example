# Flux operator settings for compose.yaml from the SAME GitHub Release.
# Copy to .env beside compose.yaml, fill in every REQUIRED value, keep .env private (chmod 600)
# and keep it across upgrades: the database password and FLUX_AUTH_SECRET must not change.
#   docker compose --env-file .env -f compose.yaml up -d --wait
# Generate each secret once, for example with: openssl rand -hex 32
# (without openssl: od -An -N32 -tx1 /dev/urandom | tr -d ' \n'). Hex is safe in DATABASE_URL.
# Variable names match the source checkout's app/.env.example. The image is chosen by
# compose.yaml, never here.

# --- Instance -------------------------------------------------------------------------------
# Compose project name: prefixes the containers and the pgdata/files volumes. Keep it the same
# across upgrades, or the new release starts with empty volumes.
FLUX_PROJECT=flux
# Loopback port of the API on this host; point the TLS reverse proxy at it.
FLUX_PORT=8081
# REQUIRED. The exact origin people open, e.g. https://flux.example.org. Plain http works only
# for loopback trials (http://127.0.0.1:<FLUX_PORT>); any other http origin stops the API.
FLUX_PUBLIC_ORIGIN=http://127.0.0.1:8081
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is believed. Empty trusts none.
FLUX_TRUSTED_PROXIES=

# --- Database -------------------------------------------------------------------------------
POSTGRES_USER=flux
# REQUIRED secret. Generate it (hex, see above); it is part of the database URL.
POSTGRES_PASSWORD=
POSTGRES_DB=flux

# --- Identity -------------------------------------------------------------------------------
# REQUIRED secret, at least 32 random characters. Signs sessions; changing it signs everyone out.
FLUX_AUTH_SECRET=
FLUX_PASSWORD_RESET_TTL_SECONDS=3600
# How long a session lasts unused and the longest it lasts from sign-in, such as 30m, 12h or 7d. Empty is 7d and 30d.
# ASVS Level 2 asks for 30m and 12h; see docs/operations/hardening.md.
FLUX_SESSION_IDLE=
FLUX_SESSION_MAX_AGE=
# The setup link's token (#1471): the first account, the company's owner, comes from <origin>/setup#<token>; every
# other one from an invite link or single sign-on. ./flux up writes a random one; once the company exists it does nothing.
FLUX_SETUP_TOKEN=
# Optional single sign-on with one OpenID Connect provider (docs/operations/single-sign-on.md).
# Set issuer and client id together; the client secret is a file on the host.
FLUX_OIDC_ISSUER=
FLUX_OIDC_CLIENT_ID=
FLUX_OIDC_CLIENT_SECRET_HOST_FILE=
FLUX_OIDC_LABEL=
# Existing accounts link their provider in prepare mode; switch to sso after linking (ordinary sign-in is then SSO only).
FLUX_SSO_MODE=sso
# Maximum age of provider confirmation: whole hours or days, from 1h to 30d.
FLUX_OIDC_CONFIRMATION_MAX_AGE=7d
# refresh (default) checks every 15 minutes that the provider still honours each person; off disables it.
FLUX_OIDC_STANDING=refresh
FLUX_OIDC_STANDING_INTERVAL_SECONDS=900
FLUX_AUTH_RATE_LIMIT=true
FLUX_STREAM_HEARTBEAT_MS=25000
# Map/wiki collaboration is on by default. off keeps the ordinary saved views and editors.
# Save shared working copies before planned disable; re-enable to recover/save any unsaved copy.
FLUX_LIVE_EDITING=on
# Link cards (#469): `on` lets the server fetch the title and description of a web address in a
# message, so its card shows the page's own words. Off by default: a fetch tells the site this
# server's address, and a pasted link can itself be private. Public http(s) addresses on the default
# ports only; private, loopback and link-local addresses are never fetched; sealed (encrypted)
# workspaces never fetch at all. See docs/development/containers.md.
FLUX_LINK_PREVIEWS=off
# The largest video one person can send, in MiB (1 to 1024; #1352, C-61). MP4, WebM and MOV files a browser can play play inside
# Flux and are streamed from the files volume, so each one counts against its disk. Every other file stays at 5 MiB, and in an
# encrypted space a video is an ordinary 5 MiB file. Your reverse proxy must accept request bodies this large (see
# docs/operations/reverse-proxy.md).
FLUX_VIDEO_MAX_MIB=200
# Agents reading and searching the web (#918, #954, C-29): on by default. An agent reads a public page
# (the flux_read_web tool: GET only, public http(s) addresses on the default ports, bounded) and searches with its
# provider's own web search (Anthropic, OpenAI; $0.01 a search in the key's daily budget). `off` turns both off: a read
# tells the site this server's address, a search sends the query to the provider's search partner, and the open web can
# try to instruct an agent (rights, waits and Undo are the defence). An agent reads only an address it was given (in the
# request, the task or its conversation), found on a page it read or returned by its own search in the same run, as many as
# a question needs; the run lists its searches and every address asked for, under its answer or in its end line.
FLUX_WEB_READS=on

# --- Local embeddings (optional, F-042) ----------------------------------------------------------
# `on` adds the container of docker/compose.embeddings.yaml (text-embeddings-inference with bge-m3) and makes search fuse the
# nearest vectors with BM25. It needs about 4 GiB of RAM more than the base stack (docs/operations/requirements.md) and downloads
# a 2.3 GB model on its first start. Off, the default: no container, no vector stored, search ranks by BM25 alone.
# Its memory limit (default 6g; the measured peak is 3.9 GiB) is FLUX_EMBEDDINGS_MEMORY, and its CPU limit (default 1, so a 2-core
# server keeps a core for Flux while it embeds) is FLUX_EMBEDDINGS_CPUS; the overlay reads them if you set them.
FLUX_EMBEDDINGS=off

# --- Email (optional) -----------------------------------------------------------------------
# SMTP for password reset and notification mail, e.g. smtp://user:pass@mail.example.org:587
# Empty means password reset reports "unavailable"; the in-app inbox keeps working.
FLUX_SMTP_URL=
FLUX_MAIL_FROM=

# --- Web Push (optional) --------------------------------------------------------------------
# Set all three or none. Generate the key pair once, with the release image, after the
# required values above are filled in:
#   docker compose --env-file .env -f compose.yaml run --rm --no-deps -T migrate \
#     apps/worker/node_modules/.bin/web-push generate-vapid-keys --json
FLUX_VAPID_PUBLIC_KEY=
# Secret: only the worker receives it. Back it up with the other secrets.
FLUX_VAPID_PRIVATE_KEY=
# Operator contact for push services: mailto:ops@example.org or an https:// URL.
FLUX_VAPID_SUBJECT=

# --- Checks only ----------------------------------------------------------------------------
# Enables the integration fixture endpoint for smoke checks. Leave empty on a real deployment.
FLUX_FIXTURE_TOKEN=

# Optional read-only GitHub App. Set all six together; never share secrets with agents/models.
FLUX_GITHUB_CLIENT_ID=
FLUX_GITHUB_CLIENT_SECRET=
FLUX_GITHUB_APP_ID=
FLUX_GITHUB_APP_SLUG=
FLUX_GITHUB_WEBHOOK_SECRET=
# webhook (GitHub reaches this server) or poll (no public address: open linked PRs every 2 minutes).
FLUX_GITHUB_DELIVERY=webhook
# 32-byte hex AES key; preserve with backups to reconnect retained credentials.
FLUX_GITHUB_ENCRYPTION_KEY=

# --- AI (optional) --------------------------------------------------------------------------
# People connect their own AI in Settings > AI (Connect AI). These decide what this instance allows.
# `on` lets people's agents run on their own API key (F-020, F-036); a Claude or ChatGPT plan needs the agent
# runtime instead (FLUX_AGENT_RUNTIME). Needs the key file below. Empty or `off` keeps API-key runs unavailable
# at zero cost.
FLUX_PERSONAL_RUNS=
# Owner AI connections (F-020): private targets an OpenAI-compatible endpoint may reach, e.g.
# "ollama,10.0.0.0/8". Host names, IP addresses or CIDR ranges, comma-separated. Empty allows only
# public HTTPS endpoints; cloud metadata addresses are always refused.
FLUX_AI_PRIVATE_TARGETS=
# API-key custody (O-007): absolute host path to a file of exactly 32 raw random bytes.
# Store it outside the repository and the database backup; empty keeps agents on API keys unavailable.
# ./flux mounts it for a source checkout; a release install mounts it in api and
# worker with its own Compose file (INSTALL.md, "Agents on your own AI key").
FLUX_BACKGROUND_KEY_HOST_FILE=

# --- Source checkout only ------------------------------------------------------------------
# ./flux creates docker/.env once from this template and generates its local demo secrets.
# These values are not passed to services by the pull-only operator Compose.
FLUX_MAILPIT_PORT=8025
FLUX_DEV_PORT=5173
FLUX_DEMO_OWNER_PASSWORD=
FLUX_DEMO_PARTNER_PASSWORD=
# The agent in Flux on the owner's own Claude Code or Codex (F-022 AIM-3; docs/operations/agent-runtime.md).
# Empty (the default) is off: no runtime service runs. claude_code, codex or claude_code,codex starts the
# Compose profile `runtime` with ./flux up.
# The first interactive ./flux up, and ./flux ai on, ask and write this for you.
# A RELEASE install (compose.yaml only) ignores the variables below. The optional compose.runtime.yaml
# of the same release reads them: `sh runtime.sh on codex` writes this switch and generates the secrets.
FLUX_AGENT_RUNTIME=
# Required with claude_code: the date (YYYY-MM-DD) you agreed to Anthropic's Commercial Terms with Anthropic.
# Flux records this statement; it does not verify it.
FLUX_AGENT_RUNTIME_COMMERCIAL_TERMS=
# Optional idle policy: release a binding after this many days without a run (1-365). Empty is off.
FLUX_AGENT_RUNTIME_IDLE_DAYS=
# Optional. How many agents run at once; empty works it out from the runtime's memory, about 2 on a 4 GB server.
# The others wait with "Waiting for room on the server".
FLUX_RUNTIME_MAX_RUNS=
# Optional. What the runtime may use together, for example 2560m and 1. Empty: ./flux and runtime.sh take the server's memory
# less 1.25 GiB and all its CPUs but one.
FLUX_RUNTIME_MEMORY=
FLUX_RUNTIME_CPUS=
# Secrets ./flux (or runtime.sh) generates: the service secret (API, worker, runtime-manager) and the runtime's own
# (the runtime and runtime-manager only).
FLUX_RUNTIME_MANAGER_SECRET=
FLUX_RUNTIME_SECRET_1=
# Encrypted workspaces (F-030). ./flux generates FLUX_KEYRING_TOKEN and FLUX_KEY_PIN_SECRET (and ./flux upgrade adds
# them to an older file). A release install has no ./flux: set each by hand with `openssl rand -hex 32`; left empty,
# Flux starts but no encrypted workspace can be created or unlocked. FLUX_KEYRING_TOKEN
# authenticates the API and worker to the keyring on its internal network and opens nothing by itself.
# FLUX_KEYRING=off disables encrypted workspaces (each stays locked). FLUX_SWAP_ACKNOWLEDGED=encrypted-swap declares
# that every swap device is encrypted with a key not stored on disk; only then may keys be held where swap is on.
FLUX_KEYRING=on
FLUX_KEYRING_TOKEN=
# FLUX_KEY_PIN_SECRET: the API and worker pin every unlock password
# and key version of an encrypted space with it, so rows planted in the database are refused. Never change it: every
# encrypted space made with it would then refuse to unlock. Back it up with this file, not with the database.
FLUX_KEY_PIN_SECRET=
FLUX_SWAP_ACKNOWLEDGED=
# Memory of db, api, worker and keyring; swap is limited to the same value, so these containers cannot swap.
# The defaults add up to under 3 GiB: the whole base stack fits a 4 GB host.
FLUX_DB_MEMORY=768m
FLUX_API_MEMORY=1536m
FLUX_WORKER_MEMORY=512m
FLUX_KEYRING_MEMORY=128m
