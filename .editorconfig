# Matches the existing code; editors apply it to new edits only (#202).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Two trailing spaces are a Markdown hard line break (used in the foundation document).
[*.md]
trim_trailing_whitespace = false
