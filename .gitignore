# Machine-local agent sessions, cursors, locks, and temporary artifacts.
/.harness/local/

# Task and review checkouts, kept beside the main checkout without root status noise.
/.worktrees/

# Python bytecode from the repository validation tools.
__pycache__/

# Application dependency and build output.
node_modules/
dist/
.env
# The worker's kernel sandbox is compiled in the image build (docker/Dockerfile), never committed.
*.node

# Test and tool artifacts.
test-results/
playwright-report/
coverage/
*.tsbuildinfo
*.log
.DS_Store

# Backups and project exports written by ./flux (issue #123).
/backups/
/exports/
/.flux-backup-lock-*/

# Server measurement results written by scripts/check_performance.sh (#298).
/perf-results/
# The operator's own Compose override (for example extra agent runtime slots); ./flux reads it.
/docker/compose.override.yaml

# Visual consistency audit output written by scripts/visual_audit.sh (#763).
/visual-audit/

# ZAP reports written by scripts/check_dast.sh (#838).
/dast-reports/

# Retrieval bench output (#1242): the seed, vectors, results and stats of scripts/eval/retrieval/run.sh.
/scripts/eval/retrieval/out/
